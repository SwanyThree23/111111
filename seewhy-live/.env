# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://rxlgywvfclyjdfyvfvyc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.rxlgywvfclyjdfyvfvyc.supabase.co:5432/postgres

# Auth (RS256)
JWT_PRIVATE_KEY=<RS256 PEM private key - generate with: openssl genrsa -out private.pem 2048>
JWT_PUBLIC_KEY=<RS256 PEM public key - generate with: openssl rsa -in private.pem -pubout -out public.pem>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Anthropic Claude
ANTHROPIC_API_KEY=<claude api key>

# Redis (Upstash or self-hosted)
REDIS_URL=redis://localhost:6379

# LiveKit (optional - mediasoup is primary)
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=<livekit key>
LIVEKIT_API_SECRET=<livekit secret>

# MediaSoup
MEDIASOUP_ANNOUNCED_IP=2.24.194.112

# MediaMTX
MEDIAMTX_API_URL=http://localhost:9997

# VaultPro (AES-256-GCM for stream key encryption)
VAULTPRO_MASTER_KEY=<32-byte hex string - generate with: openssl rand -hex 32>

# App
NEXT_PUBLIC_API_URL=https://api.seewhylive.online
APP_URL=https://seewhylive.online
CORS_ORIGINS=https://seewhylive.online,https://www.seewhylive.online,http://localhost:3000
PORT=4000
NODE_ENV=production

# GHL Integration
GHL_API_KEY=<ghl inbound key>
GHL_WEBHOOK_SECRET=<hmac secret>
